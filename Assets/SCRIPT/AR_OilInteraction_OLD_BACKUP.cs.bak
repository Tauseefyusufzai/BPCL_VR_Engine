    [Tooltip("Height offset for AR panel above engine")]
    [SerializeField] private float arPanelHeightOffset = 0.3f;
    
    [Tooltip("Scale of the AR benefits panel (0.001-0.003 recommended)")]
    [SerializeField] private float arPanelScale = 0.0015f;

    #endregion

    #region Serialized Fields - Spawn Settings

    [Header("=== SPAWN SETTINGS ===")]
    [Tooltip("Distance from camera to spawn objects (1-3 meters recommended)")]
