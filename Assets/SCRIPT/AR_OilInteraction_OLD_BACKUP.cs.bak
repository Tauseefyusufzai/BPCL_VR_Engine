    [Tooltip("Spacing between bottles (0.5-1.0 meters)")]
    [SerializeField] private float bottleSpacing = 1.0f; // Good spacing
    
    [Tooltip("Scale of spawned objects - ENGINE scale in AR (1.0 = real size)")]
    [SerializeField] private float objectScale = 1.5f; // Much larger for visibility

    #endregion

    #region Serialized Fields - Tilt Detection

    [Header("=== TILT DETECTION ===")]
    [Tooltip("Y-axis acceleration threshold. More negative = more tilt needed. Try -0.3 to -0.5")]
    [SerializeField] private float tiltThreshold = -0.35f;
    
    [Tooltip("Duration to complete pour when tilting (seconds)")]
    [SerializeField] private float pourDuration = 2.5f;
    
    [Tooltip("Smoothing factor for accelerometer (0.1=smooth, 0.5=responsive)")]
    [SerializeField] private float accelerometerSmoothing = 0.25f;
    
    [Tooltip("Maximum distance from engine allowed during pour (meters). Too far = Wrong Pouring")]
    [SerializeField] private float maxPourDistance = 3.0f;

    #endregion

    #region Serialized Fields - Visual Feedback

    [Header("=== VISUAL FEEDBACK ===")]
    [SerializeField] private Color highlightColor = Color.yellow;
    [SerializeField] private Color bpclColor = new Color(0.2f, 0.6f, 0.2f); // Green tint
    [SerializeField] private Color localColor = new Color(0.6f, 0.2f, 0.2f); // Red tint

    #endregion

    #region Serialized Fields - Particle Effects

    [Header("=== PARTICLE EFFECTS ===")]
    [SerializeField] private ParticleSystem smokeParticles;
    [SerializeField] private ParticleSystem blackSmokeParticles;
    [SerializeField] private ParticleSystem pouringParticles;

    #endregion

    #region Serialized Fields - UI Elements

    [Header("=== UI ELEMENTS ===")]
    [SerializeField] private GameObject uiPanel;
    [SerializeField] private TextMeshProUGUI statusText;
    [SerializeField] private TextMeshProUGUI instructionText;
    [SerializeField] private Slider pourProgressSlider;
    [SerializeField] private Button resetButton;
    [SerializeField] private Image tiltIndicator;
    [SerializeField] private GameObject resultPanel;
    [SerializeField] private TextMeshProUGUI resultText;
    
    [Header("=== BPCL BENEFITS PANEL ===")]
    [SerializeField] private GameObject benefitsPanel;
    [SerializeField] private TextMeshProUGUI benefitsText;
    [SerializeField] private ScrollRect benefitsScrollRect;

    #endregion

    #region Serialized Fields - Animation Settings

    [Header("=== ANIMATION SETTINGS ===")]
    [SerializeField] private float smoothTransitionDuration = 1.0f;
    [SerializeField] private float vibrationIntensity = 0.005f;
    [SerializeField] private float vibrationFrequency = 30f;

    #endregion

    #region Serialized Fields - Audio

    [Header("=== AUDIO ===")]
    [SerializeField] private AudioSource audioSource;
    [SerializeField] private AudioClip selectSound;
    [SerializeField] private AudioClip pourSound;
    [SerializeField] private AudioClip smoothEngineSound;
    [SerializeField] private AudioClip roughEngineSound;
    [SerializeField] private AudioClip warningSound;

    #endregion

    #region Private Fields

    // Spawned objects
    private GameObject spawnedEngine;
    private GameObject spawnedBPCLBottle;
    private GameObject spawnedLocalBottle;

    // State tracking
    private bool hasSpawned = false;
    private bool planeDetected = false;
    private OilType selectedOil = OilType.None;
    private EngineState currentEngineState = EngineState.Idle;
    private bool isPouringInProgress = false;
    private bool hasPoured = false;

    // Tilt tracking
    private float smoothedAccelY = 0f;
    private float pourProgress = 0f;

    // AR data
    private List<ARRaycastHit> raycastHits = new List<ARRaycastHit>();
    private Vector3 detectedPlanePosition;

    // Materials for highlighting
    private Dictionary<GameObject, Material[]> originalMaterials = new Dictionary<GameObject, Material[]>();
    private Material highlightMaterial;

    // Engine animator reference
    private AdvancedEngineAnimator engineAnimator;
    private Vector3 engineOriginalPosition;
    
    // Oil tank hole reference
    private Transform oilTankHoleTransform;
    
    // AR World Space Benefits Panel
    private GameObject arBenefitsPanel;
    private Canvas arBenefitsCanvas;
    private TMPro.TextMeshProUGUI arBenefitsText;
    
    // Bottle animation state
    private Vector3 bottleOriginalPosition;
    private Quaternion bottleOriginalRotation;
    private bool isBottleAnimating = false;

    // Coroutine references
    private Coroutine vibrationCoroutine;
    private Coroutine transitionCoroutine;
    private Coroutine benefitsScrollCoroutine;
    private Coroutine bottlePourCoroutine;

