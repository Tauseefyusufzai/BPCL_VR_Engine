/// <summary>
/// AR Oil Interaction Demo - Manages AR plane detection, bottle selection via touch,
/// tilt-based pouring gesture, and engine state transitions based on oil type.
/// Designed for Samsung S23 Android device.
/// </summary>
public class AR_OilInteraction : MonoBehaviour
{
    #region Enums

    public enum OilType
    {
        None,
        BPCL,
        Local
    }

    public enum EngineState
    {
        Idle,
        Smooth,
        Vibrating
    }

    #endregion

    #region Serialized Fields - AR Components

    [Header("=== AR COMPONENTS ===")]
